---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面不存在" description="没有找到这个页面">
  <section class="notfound">
    <span class="notfound__code">404</span>
    <h1 class="notfound__title">这里什么都没有</h1>
    <p class="notfound__text">
      页面可能被移走了，或者链接输错了。
    </p>
    <p>
      <a href="/">回到首页</a>
    </p>
  </section>
</BaseLayout>
