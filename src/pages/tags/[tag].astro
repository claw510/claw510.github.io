---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts, collectTags } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = collectTags(posts);

  return tags.map(({ tag, count }) => ({
    // params 里放原始标签字符串；链接侧统一 encodeURIComponent
    params: { tag },
    props: { tag, count },
  }));
}

const { tag, count } = Astro.props;
const allPosts = await getPublishedPosts();
const posts = allPosts.filter((post) => post.data.tags.includes(tag));
---

<BaseLayout title={`标签：${tag}`} description={`标签「${tag}」下的全部文章，共 ${count} 篇`}>
  <section class="intro">
    <h1 class="intro__title">标签：{tag}</h1>
    <p class="intro__lede">
      共 {count} 篇 ·
      <a href="/tags/">全部标签</a>
    </p>
  </section>

  <div class="post-list">
    {posts.map((post) => <PostCard post={post} />)}
  </div>
</BaseLayout>
