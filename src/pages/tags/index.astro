---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, collectTags, tagUrl } from '../../lib/posts';

const posts = await getPublishedPosts();
const tags = collectTags(posts);
---

<BaseLayout title="标签" description="按标签浏览全部文章">
  <section class="intro">
    <h1 class="intro__title">标签</h1>
    <p class="intro__lede">共 {tags.length} 个标签，{posts.length} 篇文章。</p>
  </section>

  {
    tags.length === 0 ? (
      <p>还没有标签。在文章 frontmatter 的 <code>tags</code> 里加上就会有。</p>
    ) : (
      <ul class="tag-cloud">
        {tags.map(({ tag, count }) => (
          <li>
            <a class="tag-cloud__item" href={tagUrl(tag)}>
              {tag}
              <span class="tag-cloud__count">{count}</span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>
