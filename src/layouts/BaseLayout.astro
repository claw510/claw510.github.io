---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../site';

interface Props {
  /** 页面标题，会自动拼上站名 */
  title?: string;
  /** meta description */
  description?: string;
  /** og:type */
  type?: 'website' | 'article';
  /** 文章发布时间（ISO），仅文章页传 */
  publishedTime?: string;
}

const {
  title,
  description = SITE.description,
  type = 'website',
  publishedTime,
} = Astro.props;

const pageTitle = title ? `${title} · ${SITE.title}` : SITE.title;

// 站内绝对地址，全部由 astro.config.mjs 的 site 推导，不写死
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : Astro.url.pathname;

const ogImage = Astro.site ? new URL('/favicon.svg', Astro.site).href : '/favicon.svg';
---

<!doctype html>
<html lang={SITE.lang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE.title} · RSS`}
      href="/rss.xml"
    />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="zh_CN" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="twitter:card" content="summary" />

    {/* 在首屏渲染前定好主题，避免深色模式白闪 */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var theme =
            stored === 'light' || stored === 'dark'
              ? stored
              : window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light';
          document.documentElement.dataset.theme = theme;
        } catch (e) {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <Header />

    <main id="main" class="container">
      <slot />
    </main>

    <Footer />

    {/* 主题切换：手动切换 + localStorage 记忆；未手动选择时跟随系统 */}
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var btn = document.getElementById('theme-toggle');

        function sync() {
          if (!btn) return;
          var isDark = root.dataset.theme === 'dark';
          btn.setAttribute('aria-label', isDark ? '切换到浅色模式' : '切换到深色模式');
          btn.setAttribute('title', isDark ? '切换到浅色模式' : '切换到深色模式');
        }

        function hasStored() {
          try {
            var v = localStorage.getItem('theme');
            return v === 'light' || v === 'dark';
          } catch (e) {
            return false;
          }
        }

        if (btn) {
          btn.addEventListener('click', function () {
            var next = root.dataset.theme === 'dark' ? 'light' : 'dark';
            root.dataset.theme = next;
            try {
              localStorage.setItem('theme', next);
            } catch (e) {
              /* 隐私模式下写入失败，忽略即可 */
            }
            sync();
          });
        }

        // 用户没手动选过 → 跟随系统变化
        var mq = window.matchMedia('(prefers-color-scheme: dark)');
        var onChange = function (e) {
          if (hasStored()) return;
          root.dataset.theme = e.matches ? 'dark' : 'light';
          sync();
        };
        if (mq.addEventListener) {
          mq.addEventListener('change', onChange);
        } else if (mq.addListener) {
          mq.addListener(onChange);
        }

        sync();
      })();
    </script>
  </body>
</html>
